              <frame w="56" h="56" fill="linear-gradient(135deg, #450af5 0%, #c4efd9 100%)">
                <img src="https://api.iconify.design/lucide/heart.svg?color=%23ffffff" w="24" h="24" abs="true" x="16" y="16" />
